# IQ Key Value Gateway Service Environment Variables Template
# Copy this file to .env.local, .env.uat, or .env.prd and configure values

# =============================================================================
# Spring Profile Configuration
# =============================================================================
SPRING_PROFILES_ACTIVE=local

# =============================================================================
# IAM Service Configuration
# =============================================================================
IAM_SERVICE_URI=http://localhost:8080
IAM_JWKS_URI=http://localhost:8080/.well-known/jwks.json

# =============================================================================
# CORS Configuration
# =============================================================================
CORS_ALLOWED_ORIGINS=*

# =============================================================================
# Server Configuration
# =============================================================================
SERVER_PORT=8080
MANAGEMENT_PORT=8081

# =============================================================================
# Single-Tenancy Mode Configuration
# =============================================================================
# Platform-wide operational mode: MULTI_TENANT (default) or SINGLE_TENANT
# All three services (IAM, Billing, Gateway) must use the same value
ROLLOUT_MODE=MULTI_TENANT

# Default tenant key for SINGLE_TENANT mode — must match IAM service configuration
# Format: 8-character NanoID using alphabet [a-z0-9], e.g. abc12345
DEFAULT_TENANT_KEY=

# IAM service base URL used to verify canonical rollout mode at startup
# The gateway queries IAM's actuator endpoint to confirm mode consistency
IAM_SERVICE_URL=http://foundation-iam-service:8080
